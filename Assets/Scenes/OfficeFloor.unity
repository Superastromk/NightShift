  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NightShift.Progression.RecoveryAnnouncer
  Lines:
  - ClipId: sys_recovery_1
    Subtitle: '[TEMPORAL RECOVERY] Your death has been reversed. Your workstation is expecting you.'
  - ClipId: sys_recovery_2
    Subtitle: '[TEMPORAL RECOVERY] A second death has been reversed. Please treat this as your final warning.'
  - ClipId: sys_recovery_3
    Subtitle: '[TEMPORAL RECOVERY] Third death recorded. Repeated mortality has been noted in your personnel file.'
  - ClipId: sys_recovery_4
    Subtitle: '[TEMPORAL RECOVERY] Each additional death will now be charged to your annual leave.'
  - ClipId: sys_recovery_5
    Subtitle: '[TEMPORAL RECOVERY] Death reversed. You are familiar with the procedure.'
  TierNotes:
  - 
  - It felt that.
  - It remembers where you died.
  - It knows where you are going.
  - It remembers everything.
  Delay: 1.1
